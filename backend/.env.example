DATABASE_URL="postgresql://aelika:aelika@localhost:5432/aelika?schema=public"

PORT=3001

JWT_SECRET="dev-secret-change-me"
JWT_EXPIRES_IN="7d"

# Storefront base URL used to build catalogoUrl in GET /internal/bot-config
# (no trailing slash — the tenant slug is appended directly).
STOREFRONT_BASE_URL="http://localhost:3000/tienda"

# Comma-separated list of allowed CORS origins (no wildcard). Defaults to the
# local dev origins if unset. In staging/production set this explicitly, e.g.:
# CORS_ORIGINS="https://app.staging.aelika.com,https://pide.staging.aelika.com"
CORS_ORIGINS="http://localhost:3000,http://pide.localhost:3000"

# Stripe Connect (platform account) — see StripeService (backend/src/stripe/stripe.service.ts).
STRIPE_SECRET_KEY="sk_test_..."
# Signing secret for the /webhooks/stripe endpoint (from the Stripe CLI or the
# webhook endpoint's settings in the Dashboard) — never the same value as
# STRIPE_SECRET_KEY.
STRIPE_WEBHOOK_SECRET="whsec_..."

# This backend's own public base URL (no trailing slash) — used to build the
# return_url/refresh_url Stripe redirects the tenant's browser back to after
# hosted Connect onboarding (GET /internal/stripe/onboarding-complete and
# .../onboarding-refresh, both on this same API, not the frontend).
API_BASE_URL="http://localhost:3001"
