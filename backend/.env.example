DATABASE_URL="postgresql://aelika:aelika@localhost:5432/aelika?schema=public"

PORT=3001

JWT_SECRET="dev-secret-change-me"
JWT_EXPIRES_IN="7d"

# Storefront base URL used to build catalogoUrl in GET /internal/bot-config
# (no trailing slash — the tenant slug is appended directly).
STOREFRONT_BASE_URL="http://localhost:3000/tienda"

# Comma-separated list of allowed CORS origins (no wildcard). Defaults to the
# local dev origins if unset. In staging/production set this explicitly, e.g.:
# CORS_ORIGINS="https://app.staging.aelika.com,https://pide.staging.aelika.com"
CORS_ORIGINS="http://localhost:3000,http://pide.localhost:3000"

# Stripe Connect (platform account) — see StripeService (backend/src/stripe/stripe.service.ts).
STRIPE_SECRET_KEY="sk_test_..."
# Signing secret for classic v1 events (PaymentIntent) on the /webhooks/stripe
# endpoint (from the Stripe CLI or the webhook endpoint's settings in the
# Dashboard) — never the same value as STRIPE_SECRET_KEY.
STRIPE_WEBHOOK_SECRET="whsec_..."
# Signing secret for v2 thin events (Connect account capability updates) on the
# same /webhooks/stripe endpoint — a separate Event Destination in Stripe, with
# its own secret, distinct from STRIPE_WEBHOOK_SECRET above.
STRIPE_WEBHOOK_SECRET_V2="whsec_..."

# This backend's own public base URL (no trailing slash) — used to build the
# return_url/refresh_url Stripe redirects the tenant's browser back to after
# hosted Connect onboarding (GET /internal/stripe/onboarding-complete and
# .../onboarding-refresh, both on this same API, not the frontend).
API_BASE_URL="http://localhost:3001"

# Redis: BullMQ (see backend/src/notificaciones/queue), el token de conexión de
# Telegram y los códigos/límites del acceso al portal (backend/src/portal).
# Points at the "redis" service in docker-compose.yml for local dev. Railway
# staging y producción ya tienen su propia REDIS_URL (servicio Redis interno).
REDIS_URL="redis://localhost:6379"

# Portal del cliente B2B (Fase 4, 4b).
# Secreto del HMAC de los códigos de acceso. Si no se define se usa JWT_SECRET.
PORTAL_OTP_SECRET=""
# SOLO PRUEBAS: con "true" el código de acceso se escribe en el registro del servidor
# (nunca en la respuesta HTTP). Se ignora siempre en el proyecto aelika-production.
PORTAL_CODIGO_EN_LOG=""
# Tope diario de códigos por negocio (default 300).
PORTAL_TOPE_DIARIO_NEGOCIO=""

# Notificaciones — proveedores de canal (see backend/src/notificaciones/providers).
# Bot dedicado a notificaciones, NO el bot conversacional de Botpress (ese
# vive dentro de Botpress, sin token expuesto en este backend) — ver
# TelegramProvider y CLAUDE.md.
TELEGRAM_BOT_TOKEN=""
# Username del mismo bot (sin @), usado para armar el deep link
# t.me/<username>?start=<token> — ver TelegramConexionService.
TELEGRAM_BOT_USERNAME=""
# Secreto fijo mandado a Telegram al registrar el webhook (parámetro
# secret_token de setWebhook) y verificado en cada request entrante — ver
# TelegramWebhookSecretGuard. Cualquier string largo/aleatorio sirve.
TELEGRAM_WEBHOOK_SECRET=""
# API key de Resend (dashboard.resend.com).
RESEND_API_KEY=""
# Dirección de envío única de Aelika, YA verificada en Resend — el nombre
# visible del remitente (NotificacionCanalConfig.config.nombreRemitente) lo
# elige cada tenant, pero el dominio de envío es siempre este. Ver
# CorreoProvider — no confirmado todavía cuál es el dominio real verificado
# en producción, ver CLAUDE.md.
RESEND_FROM_ADDRESS="notificaciones@aelika.com"

# Módulo de Lealtad (backend/src/lealtad/) — integración de Aelika como
# plataforma, no una credencial por tenant: una sola cuenta de WalletWallet
# API emite los pases de todos los negocios, diferenciados por
# LoyaltyCard.serialNumber/token. Ver CLAUDE.md.
WALLETWALLET_API_KEY=""

# Cloudflare R2: fotos de productos (POST /products/imagen). Token S3 de R2 con permiso de escritura al bucket.
# R2_PUBLIC_BASE_URL es el dominio público del bucket (r2.dev o dominio propio), sin diagonal final.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
R2_PUBLIC_BASE_URL=""
