// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OPERADOR
  GERENTE
  DUENO
}

// Governs whether/how PublicService.createOrder requires the factura* fields
// on Order — see PublicService for the actual per-mode validation.
enum FacturacionModo {
  OBLIGATORIO
  OPCIONAL
  DESACTIVADO
}

// Tenant-level config for the PedidoB2b module (see below) — governs when
// PedidosB2bService enforces Tenant.pedidoB2bMinimoPiezas: AL_INICIO blocks
// at payment/checkout (PedidosB2bService.marcarPagado), AL_FINAL blocks at
// order confirmation (PedidosB2bService.confirmar). Snapshotted onto
// PedidoB2b.modoCobro at creation time so a later config change never
// retroactively changes an in-flight order's rules.
enum PedidoB2bModoCobro {
  AL_INICIO
  AL_FINAL
}

// Tipo de storefront del negocio — lista extensible a propósito (no un
// booleano B2B/B2C): se espera agregar más valores en el futuro, posiblemente
// ligados a otras verticales de negocio (ver nav-items.ts en el frontend,
// que filtra la navegación del dashboard según este campo). Agregar un
// tercer valor es solo una migración que extiende el enum — no requiere
// rediseñar el campo ni la columna.
enum TipoStorefront {
  RETAIL_B2C
  RETAIL_B2B
}

// Vertical/giro del negocio — dato de segmentación interna de Aelika, no del
// canal de venta (ver TipoStorefront, concepto independiente). Pensado para
// que Aelika Scan (Módulo 5, en definición) ajuste pesos/umbrales de
// calificación por vertical; ese ajuste todavía no existe, este campo solo
// deja el dato disponible.
enum GiroNegocio {
  RESTAURANTE
  CAFETERIA
  HOTEL
  RENTA_VACACIONAL
  MAYORISTA
  OTRO
}

model Tenant {
  id                           String             @id @default(uuid())
  slug                         String             @unique
  nombre                       String
  // Elegido explícitamente al registrar el negocio (RegisterDto.tipoStorefront
  // es obligatorio, sin default a nivel de API) — el @default de aquí es solo
  // para el backfill de tenants creados antes de este campo, que
  // históricamente eran todos retail de pickup. Ver TipoStorefront arriba.
  tipoStorefront               TipoStorefront     @default(RETAIL_B2C)
  // Obligatorio en RegisterDto (sin default a nivel de API) para tenants
  // nuevos; nullable en DB para no romper tenants ya existentes (Entredós,
  // Banetto), que se actualizarán manualmente desde Ajustes. Ver GiroNegocio.
  giroNegocio                  GiroNegocio?
  logoUrl                      String?
  // { lunes: { abierto, apertura: "HH:mm"|null, cierre: "HH:mm"|null }, ..., domingo: {...} }
  // apertura/cierre are null when abierto is false. See backend/src/common/horario.ts.
  horarioAtencion              Json?
  ubicacion                    String?
  // No DB default on purpose — null means "not set yet". TenantService applies
  // a sensible default when reading, so we never need to backfill this column.
  mensajeBienvenida            String?
  // Contact email used specifically as Stripe Connect's contact_email when
  // creating the tenant's connected account (see TenantService.createOrContinueStripeAccount)
  // — not a general business/support email, deliberately scoped to Stripe.
  // No default/backfill: stays null until the Dueño fills it in via PATCH
  // /tenant/me, which is exactly what forces it to be set before Stripe
  // onboarding can start for a given tenant.
  stripeContactEmail           String?
  // Bot (Botpress) auth key against the Aelika API — generated once at
  // register time (crypto.randomBytes, see AuthService), regenerable via
  // POST /tenant/me/regenerate-bot-key. Never empty, never editable via the
  // general PATCH /tenant/me.
  botApiKey                    String             @unique
  // Sentido inverso a botApiKey (Aelika -> Botpress, no Botpress -> Aelika):
  // URL de la integración Webhook del tenant en Botpress Studio (card
  // "Start Conversation") que ReglaEnvioService llama para iniciar una
  // conversación de WhatsApp. Null hasta que se configure a mano en base de
  // datos (Etapa 2a, sin pantalla en el panel todavía) — ReglaEnvioService
  // falla explícito si un tenant sin esto intenta enviar. botWebhookSecret
  // es opcional porque no todo webhook de Botpress exige uno, pero cuando
  // existe se manda en el header `x-bp-secret` de cada POST saliente (así
  // es como la integración Webhook de Botpress lo espera).
  botWebhookUrl                String?
  botWebhookSecret             String?
  // PIN de 4-6 dígitos que protege la pantalla de registro de sellos del
  // Módulo de Lealtad (backend/src/lealtad/) — hasheado con bcrypt, mismo
  // patrón que User.passwordHash (ver AuthService), nunca texto plano: a
  // diferencia de botApiKey (secreto de alta entropía que el backend
  // necesita leer de vuelta para comparar un header), este es un candado
  // corto y solo se compara, nunca se muestra de vuelta. Null hasta que el
  // Dueño lo configure — sin pantalla en el panel todavía en esta fase.
  pinLealtad                   String?
  // Umbral del candado de frecuencia (ReglaCandadoService, Etapa 1): días
  // mínimos entre dos envíos MARKETING al mismo Cliente. Null = usa el
  // default en código (7 días, ver ReglaCandadoService) — nunca se
  // backfillea el valor explícito, mismo criterio que mensajeBienvenida
  // (null = "no configurado todavía", no "cero").
  candadoMarketingDias         Int?
  // Whether/how factura* fields on Order are required at checkout — see
  // FacturacionModo and PublicService.createOrder.
  facturacionModo              FacturacionModo    @default(DESACTIVADO)
  // Stripe Connect connected account for this tenant (platform = Aelika).
  // Null until POST /internal/tenants/:slug/stripe-account is called — see
  // InternalService. chargesEnabled/payoutsEnabled mirror the connected
  // account's own fields of the same name, refreshed from Stripe (never
  // trusted as stale) by GET /internal/tenants/:slug/stripe-status and by
  // the account.updated webhook event.
  stripeAccountId              String?            @unique
  stripeChargesEnabled         Boolean            @default(false)
  stripePayoutsEnabled         Boolean            @default(false)
  // Config del módulo de pedidos B2B a crédito (ver PedidoB2b) — a nivel
  // tenant, no por pedido/cliente. modoCobro/minimoPiezas se snapshotean en
  // cada PedidoB2b al crearse, así que cambiar esto no afecta pedidos ya
  // creados.
  pedidoB2bModoCobro           PedidoB2bModoCobro @default(AL_FINAL)
  pedidoB2bMinimoPiezas        Int                @default(100)
  // Ventana semanal recurrente en la que el storefront público de mayoreo
  // acepta pedidos nuevos — reemplaza a horarioAtencion/isAbiertoAhora para
  // este módulo (ver PublicPedidosB2bService.createPedido). Los 4 campos
  // son todos null u todos no-null (ver normalizarVentanaRecepcion en
  // common/ventana-recepcion-b2b.ts) — null significa "sin ventana
  // configurada", que se trata como siempre abierta (nunca bloquea). Rango
  // simple dentro de una misma semana lunes-domingo: aperturaDia debe ser
  // igual o anterior a cierreDia en ese orden — no se soportan ventanas que
  // crucen domingo→lunes.
  pedidoB2bVentanaAperturaDia  DiaSemana?
  pedidoB2bVentanaAperturaHora String?
  pedidoB2bVentanaCierreDia    DiaSemana?
  pedidoB2bVentanaCierreHora   String?
  createdAt                    DateTime           @default(now())
  updatedAt                    DateTime           @updatedAt

  users                     User[]
  categories                Category[]
  products                  Product[]
  promotions                Promotion[]
  orders                    Order[]
  orderItems                OrderItem[]
  puntosEnvio               PuntoEnvio[]
  modifierGroups            ModifierGroup[]
  modifierOptions           ModifierOption[]
  orderItemModifiers        OrderItemModifier[]
  payments                  Payment[]
  pedidosB2b                PedidoB2b[]
  pedidoB2bItems            PedidoB2bItem[]
  pedidoB2bItemsDia         PedidoB2bItemDia[]
  pedidoB2bCodigosDescuento PedidoB2bCodigoDescuento[]
  notificacionCanalConfigs  NotificacionCanalConfig[]
  notificacionEventoConfigs NotificacionEventoConfig[]
  clientes                  Cliente[]
  reglas                    Regla[]
  reglaEnvioLogs            ReglaEnvioLog[]
  loyaltyCards              LoyaltyCard[]
  loyaltyVisits             LoyaltyVisit[]
  loyaltyRedemptions        LoyaltyRedemption[]

  @@map("tenants")
}

model User {
  id           String   @id @default(uuid())
  tenantId     String
  nombre       String
  email        String   @unique
  passwordHash String
  rol          Role
  activo       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("users")
}

model Category {
  id        String   @id @default(uuid())
  tenantId  String
  nombre    String
  orden     Int      @default(0)
  activa    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products Product[]

  @@index([tenantId])
  @@map("categories")
}

model Product {
  id          String   @id @default(uuid())
  tenantId    String
  categoryId  String
  nombre      String
  descripcion String?
  precio      Decimal  @db.Decimal(10, 2)
  fotoUrl     String?
  disponible  Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant         Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category       Category               @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  orderItems     OrderItem[]
  modifierGroups ProductModifierGroup[]
  pedidoB2bItems PedidoB2bItem[]

  @@index([tenantId])
  @@index([categoryId])
  @@map("products")
}

enum PromotionTipo {
  DESCUENTO_PRODUCTO
  COMBO
}

// `config` shape depends on `tipo` (validated at the application layer, not by Postgres):
//   DESCUENTO_PRODUCTO -> { productId, tipoDescuento: 'porcentaje' | 'monto_fijo', valor }
//   COMBO              -> { productIds: string[], precioCombo }
// `valor`/`precioCombo` are money and must be validated as Decimal-shaped (2 decimal places)
// at the DTO layer, same convention as Product.precio — JSON itself has no Decimal type.
model Promotion {
  id        String        @id @default(uuid())
  tenantId  String
  tipo      PromotionTipo
  config    Json
  activa    Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("promotions")
}

enum EstadoPedido {
  PENDIENTE_CONFIRMACION
  CONFIRMADO_SURTIENDO
  LISTO_ENTREGA
  DESPACHADO
}

enum CanalOrigen {
  WEB
  WHATSAPP
  INSTAGRAM
  FACEBOOK
}

enum HoraRecogidaTipo {
  LO_ANTES_POSIBLE
  HORA_ESPECIFICA
}

enum MetodoPago {
  EFECTIVO
  // Not implemented yet (see PublicService) — kept so we don't need another
  // migration whenever this gets built.
  TRANSFERENCIA
  TARJETA
}

// Whether money has actually moved for this order. EFECTIVO/TRANSFERENCIA
// default to PAGADO at creation time (nothing for Aelika's system to track —
// the exchange happens in person). TARJETA starts PENDIENTE and only becomes
// PAGADO/FALLIDO once the Stripe webhook confirms the PaymentIntent — see
// PublicService.createOrder and StripeWebhookController. REEMBOLSADO is only
// reachable from PAGADO, via OrdersService.reembolsar (POST
// /orders/:id/reembolsar) — full refund only, no partial in v1.
enum EstadoPago {
  PENDIENTE
  // Solo TARJETA pasa por aquí — reflejo del `payment_intent.processing` de
  // Stripe (pago async, ej. algunos métodos bancarios, todavía sin
  // resolver). Distinto de PENDIENTE (el pedido nació así, sin que Stripe
  // haya dicho nada todavía) para que el estado en base de datos sea
  // explícito sobre qué le dijo Stripe al pedido — ver
  // StripeWebhookController.handleClassicEvent.
  PROCESANDO
  PAGADO
  FALLIDO
  REEMBOLSADO
}

enum MetodoEntrega {
  RECOGER
  DOMICILIO
}

// Simple named delivery zones — NOT real multi-branch/store logic (no own
// catalog, hours, or inventory). Just a name + address a customer picks for
// DOMICILIO orders, with an optional minimum order amount.
model PuntoEnvio {
  id           String   @id @default(uuid())
  tenantId     String
  nombre       String
  direccion    String
  pedidoMinimo Decimal? @db.Decimal(10, 2)
  activo       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([tenantId])
  @@map("puntos_envio")
}

// ---------------------------------------------------------------------------
// Notificaciones (Fase A: solo modelo de datos + cola base — ver CLAUDE.md.
// Ningún trigger del ciclo de vida del pedido está enganchado todavía; estos
// modelos solo describen QUÉ debería notificarse y POR DÓNDE, sin que nada
// los lea aún).
// ---------------------------------------------------------------------------

// WhatsApp queda fuera de alcance por ahora (el envío al cliente final vía
// WhatsApp ya lo cubre el bot de Botpress) — este canal es para el resto de
// notificaciones (al negocio, o al cliente por otra vía).
enum NotificacionCanalTipo {
  TELEGRAM
  SMS
  CORREO
}

// Lista extensible a propósito (mismo principio que TipoStorefront arriba)
// — agregar un evento nuevo es solo extender el enum. Fase D enganchó los 5
// triggers reales (ver OrdersService.avanzar, PublicService.createOrder,
// StripeWebhookController): PEDIDO_EN_CAMINO dispara en la transición a
// LISTO_ENTREGA (nombre pensado para el cliente final, no calca
// EstadoPedido) y PEDIDO_ENTREGADO en la transición a DESPACHADO.
enum NotificacionEvento {
  PEDIDO_RECIBIDO
  PEDIDO_CONFIRMADO
  PEDIDO_EN_CAMINO
  PEDIDO_ENTREGADO
  PAGO_CONFIRMADO
}

enum NotificacionAudiencia {
  CLIENTE
  NEGOCIO
}

// Un canal de envío configurado por el tenant (uno por NotificacionCanalTipo,
// ver @@unique abajo) — sigue el patrón de PuntoEnvio (colección tenant-owned
// con su propio ciclo de vida CRUD), no campos sueltos en Tenant, porque cada
// canal trae su propia credencial/config y puede prenderse o apagarse por
// separado.
model NotificacionCanalConfig {
  id        String                @id @default(uuid())
  tenantId  String
  tipo      NotificacionCanalTipo
  activo    Boolean               @default(true)
  // Distinto de `activo` (intención del tenant de usar el canal, Fase E) —
  // `conectado` es si el canal ya tiene lo necesario para enviar de verdad.
  // Solo TELEGRAM lo usa por ahora: false hasta que TelegramConexionService
  // captura el chatId real vía el webhook de /start (ver
  // backend/src/notificaciones/telegram/). CORREO no necesita "conectarse"
  // (el tenant solo escribe un nombre de remitente), así que se queda en
  // false para ese canal sin significado especial todavía.
  conectado Boolean               @default(false)
  // Shape depende de `tipo` (validado en la capa de aplicación, no por
  // Postgres — mismo principio que Promotion.config):
  //   TELEGRAM -> { chatId: string } — chatId lo captura el webhook de
  //               conexión, nunca lo escribe el tenant a mano. Usado tanto
  //               para enviar (NotificacionesProcessor lo resuelve como
  //               destinatario de la audiencia NEGOCIO) como remitente.
  //   SMS      -> { numeroVerificado: string }
  //   CORREO   -> { nombreRemitente: string, correoDestino?: string } —
  //               nombreRemitente es la identidad con la que el negocio le
  //               escribe A SUS CLIENTES (usado como "from" sobre el
  //               dominio fijo de Aelika, ver CorreoProvider);
  //               correoDestino es distinto: el correo AL QUE le llegan al
  //               negocio los avisos de audiencia NEGOCIO (ej. "pago
  //               confirmado"). Captura de correoDestino en el dashboard es
  //               Fase E — el modelo ya lo soporta desde Fase D.
  config    Json
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  tenant  Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  eventos NotificacionEventoConfig[]

  @@unique([tenantId, tipo])
  @@index([tenantId])
  @@map("notificacion_canal_configs")
}

// Un evento del ciclo de vida del pedido (PEDIDO_RECIBIDO/CONFIRMADO) puede
// tener varias filas — una por cada combinación audiencia+canal a la que
// debe avisar (ej. "pedido recibido" -> NEGOCIO por Telegram Y por correo al
// mismo tiempo), así que NO hay un único canal por evento+audiencia, sino
// N filas con @@unique evitando solo el duplicado exacto.
model NotificacionEventoConfig {
  id            String                @id @default(uuid())
  tenantId      String
  evento        NotificacionEvento
  audiencia     NotificacionAudiencia
  canalConfigId String
  activo        Boolean               @default(true)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  tenant      Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // Cascade (a diferencia de Order -> PuntoEnvio, que es Restrict): esta fila
  // no tiene ningún valor histórico/snapshot por sí misma — es pura config,
  // así que borrar el canal que referencia simplemente deja de notificar por
  // ahí en vez de necesitar bloquear el borrado.
  canalConfig NotificacionCanalConfig @relation(fields: [canalConfigId], references: [id], onDelete: Cascade)

  @@unique([tenantId, evento, audiencia, canalConfigId])
  @@index([tenantId])
  @@index([canalConfigId])
  @@map("notificacion_evento_configs")
}

model Order {
  id                    String           @id @default(uuid())
  tenantId              String
  folio                 String
  clienteNombre         String
  clienteTelefono       String
  // Correo general del cliente, opcional — distinto de facturaCorreo (que
  // solo existe si el tenant tiene facturación activa y el cliente la pidió
  // para ESE pedido). Este es el campo de correo "de siempre", capturado en
  // el paso "datos" del checkout junto a nombre/teléfono, sin depender de
  // facturación — pensado como destinatario principal de las notificaciones
  // de audiencia Cliente (ver OrdersService.avanzar). facturaCorreo queda
  // como respaldo para pedidos que sí tengan ese dato pero no este.
  clienteCorreo         String?
  // FK formal hacia Cliente — desde Módulo 2. Siempre presente: la crea/
  // resuelve ClientesService.sincronizarDesdePedido en la misma transacción
  // que el pedido (ver PublicService.createOrder), nunca queda huérfano tras
  // el checkout. clienteNombre/clienteTelefono/clienteCorreo de arriba siguen
  // siendo el snapshot al momento del pedido — no se leen de Cliente en
  // tiempo de consulta, esta FK es solo para poder navegar/agrupar por
  // cliente (ver architecture.md §5).
  clienteId             String
  notas                 String?
  horaRecogidaTipo      HoraRecogidaTipo @default(LO_ANTES_POSIBLE)
  // "HH:mm", same-day only (no date picker yet). Only set when
  // horaRecogidaTipo = HORA_ESPECIFICA; null otherwise. Meaningless (and
  // ignored) when metodoEntrega = DOMICILIO — see PublicService.
  horaRecogida          String?
  metodoPago            MetodoPago       @default(EFECTIVO)
  // See EstadoPago. Only meaningful for TARJETA — EFECTIVO/TRANSFERENCIA
  // are created as PAGADO and never transition.
  estadoPago            EstadoPago       @default(PAGADO)
  // Set only for metodoPago = TARJETA, right after the PaymentIntent is
  // created (same request, second write — see PublicService.createOrder).
  // Unique so the webhook can look up the order by PaymentIntent id.
  stripePaymentIntentId String?          @unique
  // Set only when estadoPago = REEMBOLSADO, right after stripe.refunds.create
  // succeeds — see OrdersService.reembolsar. No webhook confirms this in v1;
  // the Stripe API response itself is the confirmation.
  stripeRefundId        String?
  metodoEntrega         MetodoEntrega    @default(RECOGER)
  // Required (and validated as belonging to this tenant + activo) only when
  // metodoEntrega = DOMICILIO; null for RECOGER. onDelete: Restrict — unlike
  // OrderItem.productId there's no snapshot of the zone's nombre/direccion on
  // Order, so deleting a PuntoEnvio referenced by orders is blocked (409, see
  // PuntosEnvioService) rather than silently orphaning that history.
  puntoEnvioId          String?
  // Customer's actual delivery address — required only when metodoEntrega =
  // DOMICILIO (see PublicService.resolverDireccionEntrega), null for RECOGER.
  // Distinct from PuntoEnvio.direccion, which is the zone's own fixed
  // address, not the customer's.
  direccionCalle        String?
  direccionNumero       String?
  direccionColonia      String?
  direccionReferencias  String?
  // Factura (CFDI-style) fields. Whether they're required at all depends on
  // Tenant.facturacionModo at the time of the order — see PublicService.
  requiereFactura       Boolean          @default(false)
  facturaRazonSocial    String?
  facturaRfc            String?
  facturaRegimenFiscal  String?
  facturaUsoCfdi        String?
  facturaCodigoPostal   String?
  facturaCorreo         String?
  estadoPedido          EstadoPedido     @default(PENDIENTE_CONFIRMACION)
  canalOrigen           CanalOrigen      @default(WEB)
  // Sum of every discount applied at checkout (combos + descuento_producto).
  descuentoTotal        Decimal          @default(0) @db.Decimal(10, 2)
  // Human-readable summary of what was applied, e.g. "Combo Pizza+Refresco x1".
  notasDescuento        String?
  total                 Decimal          @db.Decimal(10, 2)
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // Restrict, no Cascade/SetNull — mismo criterio que PuntoEnvio arriba
  // (requerida, sin forma de dejarla nula) pero por el motivo contrario: acá
  // SÍ hay snapshot (clienteNombre/clienteTelefono en este mismo modelo), así
  // que no hay pérdida de información real; Restrict se eligió solo porque
  // clienteId es NOT NULL y Prisma no permite SetNull sobre una relación
  // requerida — Cascade borraría pedidos reales si algún día existe un
  // borrado de Cliente, lo cual no debe pasar silenciosamente.
  cliente    Cliente     @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  puntoEnvio PuntoEnvio? @relation(fields: [puntoEnvioId], references: [id], onDelete: Restrict)
  items      OrderItem[]
  payments   Payment[]

  // folio is short and human-facing (read over the phone/counter), so it only
  // needs to be unique within a tenant, not globally.
  @@unique([tenantId, folio])
  // Composite index replaces the old standalone @@index([tenantId]) — a
  // Postgres B-tree index on (tenantId, createdAt) already satisfies
  // tenantId-only lookups via the leftmost-prefix rule, so keeping both
  // would just be redundant write overhead. Added for the "today" range
  // queries behind /orders/summary (Fase 9b) and any future date-filtered
  // listing.
  @@index([tenantId, createdAt])
  @@index([puntoEnvioId])
  @@index([clienteId])
  @@map("orders")
}

// Snapshots nombreProducto/precioUnitario at order time (see CLAUDE.md) so a
// later catalog edit — or even deleting the product — never changes historical
// order data. productId is therefore nullable with onDelete: SetNull: losing
// the live link to the product loses nothing the snapshot doesn't already have.
model OrderItem {
  id             String  @id @default(uuid())
  tenantId       String
  orderId        String
  productId      String?
  nombreProducto String
  precioUnitario Decimal @db.Decimal(10, 2)
  cantidad       Int

  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order         Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product       Product?            @relation(fields: [productId], references: [id], onDelete: SetNull)
  modificadores OrderItemModifier[]

  @@index([tenantId])
  @@index([orderId])
  @@map("order_items")
}

// One row per PaymentIntent webhook event (payment_intent.succeeded/.payment_failed)
// for metodoPago = TARJETA — see StripeWebhookController.handleClassicEvent. Not
// an upsert: a failed attempt followed by a successful one for the same order
// leaves two rows, a real attempt history rather than a single mutable status.
model Payment {
  id                    String     @id @default(cuid())
  tenantId              String
  orderId               String
  stripePaymentIntentId String
  amount                Decimal    @db.Decimal(10, 2)
  currency              String
  // Reuses EstadoPago (see Order.estadoPago). PENDIENTE never applies here —
  // a Payment row is only created once the webhook has a final result
  // (succeeded or failed), never while the PaymentIntent is still in flight.
  status                EstadoPago
  paymentMethodType     String?
  // Requires an extra Stripe fetch (expand latest_charge / retrieve charge)
  // to populate — out of scope for this phase, left null.
  cardBrand             String?
  last4                 String?
  capturedAt            DateTime?
  createdAt             DateTime   @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([stripePaymentIntentId])
  @@map("payments")
}

enum TipoSeleccion {
  UNICA
  MULTIPLE
}

// First many-to-many relation in the schema (Product <-> ModifierGroup via
// ProductModifierGroup). Unlike Promotion, which deliberately references
// products through a JSON blob instead of a real FK (see Promotion's
// comment above) because it never needs to be joined/queried by product,
// modifier groups do need real joins (e.g. "which groups apply to this
// product") — so this uses actual FKs + a join table instead.
model ModifierGroup {
  id            String        @id @default(uuid())
  tenantId      String
  nombre        String
  tipoSeleccion TipoSeleccion
  obligatorio   Boolean       @default(false)
  activo        Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  tenant    Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  opciones  ModifierOption[]
  productos ProductModifierGroup[]

  @@index([tenantId])
  @@map("modifier_groups")
}

// tenantId is denormalized from modifierGroup.tenantId — same convention as
// OrderItem (denormalized from order.tenantId) — so this model can be
// registered directly in TenantPrismaService's tenantScopedQuery like every
// other tenant-owned model, instead of needing a join through ModifierGroup
// on every query.
model ModifierOption {
  id              String  @id @default(uuid())
  tenantId        String
  modifierGroupId String
  nombre          String
  precioAdicional Decimal @default(0) @db.Decimal(10, 2)
  activo          Boolean @default(true)

  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  modifierGroup ModifierGroup       @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)
  orderItems    OrderItemModifier[]

  @@index([tenantId])
  @@index([modifierGroupId])
  @@map("modifier_options")
}

// Join table for the Product <-> ModifierGroup many-to-many. No tenantId of
// its own — both sides (product, modifierGroup) are already tenant-owned,
// and every write here is validated against the authenticated tenant via
// ModifierGroupsService before touching this table (see assertGroupBelongsToTenant/
// assertProductBelongsToTenant), so it isn't registered in TenantPrismaService's
// tenantScopedQuery. onDelete: Restrict on modifierGroup (unlike Cascade on
// product) so a ModifierGroup still assigned to a product can't be deleted
// silently — ModifierGroupsService.remove catches that FK violation (P2003)
// and returns 409, same pattern as CategoriesService/PuntosEnvioService.
model ProductModifierGroup {
  productId       String
  modifierGroupId String
  orden           Int    @default(0)

  product       Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  modifierGroup ModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Restrict)

  @@id([productId, modifierGroupId])
  @@map("product_modifier_groups")
}

// Snapshots nombre/precioAdicional at order time (same principle as
// OrderItem snapshotting nombreProducto/precioUnitario) so a later edit —or
// deletion— of the ModifierOption never changes historical order data.
// modifierOptionId is therefore nullable with onDelete: SetNull.
model OrderItemModifier {
  id               String  @id @default(uuid())
  tenantId         String
  orderItemId      String
  modifierOptionId String?
  // Nombre del ModifierGroup al que pertenecía la opción (ej. "Leche",
  // "Tamaño") — snapshoteado por separado de `nombre` (el de la opción, ej.
  // "Entera") para poder armar etiquetas tipo "Leche: Entera" en recibos/
  // notificaciones sin tener que resolver el grupo desde modifierOptionId
  // (nullable, se pierde si se borra la opción). Nullable y sin backfill a
  // propósito: solo se llena hacia adelante — pedidos creados antes de este
  // campo se quedan en null, es un dato que no se puede reconstruir después.
  nombreGrupo      String?
  nombre           String
  precioAdicional  Decimal @db.Decimal(10, 2)

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orderItem      OrderItem       @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  modifierOption ModifierOption? @relation(fields: [modifierOptionId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([orderItemId])
  @@map("order_item_modifiers")
}

// ---------------------------------------------------------------------------
// Pedidos B2B a crédito (pedido semanal con distribución por día, sin cuenta
// de cliente). Entidad deliberadamente separada de Order/OrderItem — no una
// extensión — porque: (1) la distribución por día necesita una tabla hija de
// cualquier forma; (2) EstadoPedido de Order es una máquina de estados
// lineal que no representa cumplimiento parcial por día; (3) el ciclo de
// pago a crédito (confirmación manual, potencialmente al final de la
// semana) es distinto al de Order.estadoPago (inmediato / webhook de
// Stripe); y (4) mezclarlos arriesgaría los agregados de OrdersService.summary
// /summaryDaily, que asumen que cada Order.createdAt es un ingreso resuelto
// en el momento. Ver CLAUDE.md.
// ---------------------------------------------------------------------------

enum PedidoB2bEstado {
  PENDIENTE_CONFIRMACION
  CONFIRMADO_SURTIENDO
  DESPACHADO
}

// Independiente de Order.estadoPago — ver PedidoB2bModoCobro arriba. PENDIENTE
// es el único estado inicial posible: incluso en modoCobro = AL_INICIO, el
// pedido nace sin pagar y PedidosB2bService.marcarPagado es lo que lo mueve a
// PAGADO (y, en ese modo, confirma el pedido en el mismo paso).
enum PedidoB2bEstadoPago {
  PENDIENTE
  PAGADO
}

enum DiaSemana {
  LUNES
  MARTES
  MIERCOLES
  JUEVES
  VIERNES
  SABADO
  DOMINGO
}

model PedidoB2b {
  id                          String              @id @default(uuid())
  tenantId                    String
  // Folio propio, independiente de Order.folio — mismo patrón de advisory
  // lock por tenant (ver PedidosB2bService.nextFolio) pero con su propia
  // clave de lock, para no compartir namespace con el advisory lock de Order
  // (PublicService.nextFolio) ni serializarse contra él.
  folio                       String
  negocioNombre               String
  contactoNombre              String
  contactoTelefono            String
  contactoCorreo              String
  // FK formal hacia Cliente (canal B2B) — mismo motivo/mismo momento de
  // resolución que Order.clienteId, ver ese comentario. negocioNombre/
  // contactoNombre/contactoTelefono/contactoCorreo de arriba siguen siendo
  // el snapshot al momento del pedido.
  clienteId                   String
  // Lunes de la semana que cubre el pedido (fecha, sin hora) — cada
  // PedidoB2bItemDia.dia es relativo a esta semana. Validado como lunes real
  // en PedidosB2bService, no a nivel de columna/DB.
  semanaInicio                DateTime            @db.Date
  // Snapshot de Tenant.pedidoB2bModoCobro al crear el pedido — un cambio
  // posterior en la config del tenant no debe alterar retroactivamente las
  // reglas de un pedido ya en curso.
  modoCobro                   PedidoB2bModoCobro
  estado                      PedidoB2bEstado     @default(PENDIENTE_CONFIRMACION)
  estadoPago                  PedidoB2bEstadoPago @default(PENDIENTE)
  // Cancelación es un flag ortogonal a `estado`, no un estado más de la
  // secuencia — `estado` sigue siendo estrictamente lineal y sin marcha
  // atrás; cancelar puede pasar en cualquier momento antes de DESPACHADO sin
  // "gastar" un paso de esa secuencia.
  cancelado                   Boolean             @default(false)
  canceladoAt                 DateTime?
  // Snapshot de Tenant.pedidoB2bMinimoPiezas al crear el pedido — mismo
  // motivo que modoCobro. Solo se valida contra totalPiezas al confirmar/
  // pagar (ver PedidosB2bService); nunca se revalida en ediciones
  // posteriores a la confirmación.
  minimoPiezasAplicado        Int
  // Suma de PedidoB2bItem.cantidadTotal — denormalizado y recalculado en
  // cada creación/edición de items, para no sumar en cada lectura y para que
  // el listado/reporte (ver abajo) lo tenga disponible sin un join extra.
  totalPiezas                 Int                 @default(0)
  codigoDescuentoId           String?
  // Snapshot del código y % aplicados al momento del pedido — independiente
  // de codigoDescuentoId (que es opcional y onDelete: SetNull) para que el
  // pedido conserve esta información aunque el código se borre o desactive
  // después. Mismo principio de snapshot que nombreProducto/precioUnitario
  // en OrderItem.
  codigoDescuentoTexto        String?
  descuentoPorcentajeAplicado Decimal?            @db.Decimal(5, 2)
  subtotal                    Decimal             @default(0) @db.Decimal(10, 2)
  descuentoTotal              Decimal             @default(0) @db.Decimal(10, 2)
  total                       Decimal             @default(0) @db.Decimal(10, 2)
  // Mismos 6 campos + requiereFactura que Order, resueltos con la misma
  // lógica (ver backend/src/common/facturacion.ts) según el
  // Tenant.facturacionModo compartido por ambos storefronts — no hay CFDI
  // real en este módulo, solo se capturan los datos fiscales para que el
  // negocio facture por fuera del sistema.
  requiereFactura             Boolean             @default(false)
  facturaRazonSocial          String?
  facturaRfc                  String?
  facturaRegimenFiscal        String?
  facturaUsoCfdi              String?
  facturaCodigoPostal         String?
  facturaCorreo               String?
  createdAt                   DateTime            @default(now())
  updatedAt                   DateTime            @updatedAt

  tenant          Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  codigoDescuento PedidoB2bCodigoDescuento? @relation(fields: [codigoDescuentoId], references: [id], onDelete: SetNull)
  // Restrict — mismo razonamiento que Order.cliente (arriba): requerida,
  // snapshot propio ya existe en este modelo, Cascade no es aceptable.
  cliente         Cliente                   @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  items           PedidoB2bItem[]

  // folio es corto y de cara al negocio, igual que Order.folio — único por
  // tenant, no globalmente.
  @@unique([tenantId, folio])
  @@index([tenantId, semanaInicio])
  @@index([codigoDescuentoId])
  @@index([clienteId])
  @@map("pedidos_b2b")
}

// Snapshotea nombreProducto/precioUnitario al momento del pedido — mismo
// principio que OrderItem — así un cambio posterior de catálogo nunca altera
// un pedido ya creado. productId es nullable con onDelete: SetNull por la
// misma razón que en OrderItem.
model PedidoB2bItem {
  id             String  @id @default(uuid())
  tenantId       String
  pedidoB2bId    String
  productId      String?
  nombreProducto String
  precioUnitario Decimal @db.Decimal(10, 2)
  // Suma de PedidoB2bItemDia.cantidad para este item — denormalizado, ver
  // PedidoB2b.totalPiezas.
  cantidadTotal  Int

  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pedidoB2b    PedidoB2b          @relation(fields: [pedidoB2bId], references: [id], onDelete: Cascade)
  product      Product?           @relation(fields: [productId], references: [id], onDelete: SetNull)
  distribucion PedidoB2bItemDia[]

  @@index([tenantId])
  @@index([pedidoB2bId])
  @@map("pedido_b2b_items")
}

// Cantidad pedida de un item en un día específico lunes-domingo de la semana
// del pedido — la pieza que no cabe en OrderItem, que solo tiene una
// `cantidad` por línea sin dimensión de día.
model PedidoB2bItemDia {
  id              String    @id @default(uuid())
  tenantId        String
  pedidoB2bItemId String
  dia             DiaSemana
  cantidad        Int

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pedidoB2bItem PedidoB2bItem @relation(fields: [pedidoB2bItemId], references: [id], onDelete: Cascade)

  @@unique([pedidoB2bItemId, dia])
  @@index([tenantId])
  @@map("pedido_b2b_items_dia")
}

// Catálogo de códigos de descuento propio de este módulo — deliberadamente
// no reutiliza Promotion, que hoy son descuentos automáticos sobre el
// carrito del storefront de pickup, no cupones de texto que alguien ingresa.
// Ver CLAUDE.md. onDelete: SetNull en PedidoB2b.codigoDescuento — el pedido
// ya snapshotea texto/porcentaje, así que borrar el código no pierde nada
// del histórico (mismo principio que ModifierOption, sin Restrict).
model PedidoB2bCodigoDescuento {
  id                  String    @id @default(uuid())
  tenantId            String
  // Normalizado a mayúsculas por PedidosB2bService antes de guardar/buscar.
  codigo              String
  descuentoPorcentaje Decimal   @db.Decimal(5, 2)
  activo              Boolean   @default(true)
  // null = ilimitado. Sin contador persistido — resolverCodigoDescuento
  // cuenta la relación `pedidos` al vuelo en cada validación (incluyendo
  // cancelados, que no liberan el cupo — ver ese mismo comentario ahí).
  usosMaximos         Int?
  // null = sin fecha límite. Fecha calendario (@db.Date, sin hora) — el
  // código es válido durante todo ese día en timezone México, mismo
  // criterio que el resto de fechas calendario de este módulo
  // (PedidoB2b.semanaInicio). Comparado contra fechaMexicoYMD() en
  // resolverCodigoDescuento.
  fechaLimite         DateTime? @db.Date
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  tenant  Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pedidos PedidoB2b[]

  @@unique([tenantId, codigo])
  @@index([tenantId])
  @@map("pedido_b2b_codigos_descuento")
}

// B2C (Order) y B2B (PedidoB2b) son audiencias de negocio distintas — un
// mismo teléfono en ambos canales del mismo tenant se trata como dos
// Cliente separados, sin fusionar (decisión de producto). No hay FK hacia
// Order/PedidoB2b todavía (eso es Módulo 2) — este modelo solo se mantiene
// sincronizado vía ClientesService.sincronizarDesdePedido, llamado dentro de
// la misma transacción que crea el pedido en los 3 puntos de creación
// reales (ver PublicService.createOrder, PublicPedidosB2bService.createPedido,
// PedidosB2bService.create).
enum ClienteCanal {
  B2C
  B2B
}

model Cliente {
  id             String       @id @default(uuid())
  tenantId       String
  canal          ClienteCanal
  // Normalizado por ClientesService/normalizarTelefono (common/telefono.ts)
  // antes de guardar: solo dígitos, últimos 10 — así "+52 55 1111 2222",
  // "55-1111-2222" y "5511112222" resuelven al mismo Cliente. Nunca se
  // guarda el formato crudo capturado en el pedido.
  telefono       String
  // Nombre y correo más recientemente capturados — se sobreescriben en cada
  // pedido nuevo del mismo cliente (ver ClientesService). correo es opcional
  // porque Order.clienteCorreo lo es; un pedido sin correo nunca borra un
  // correo ya conocido de un pedido anterior (ClientesService no pisa con
  // null).
  nombre         String
  correo         String?
  primerPedidoAt DateTime
  ultimoPedidoAt DateTime
  totalPedidos   Int          @default(1)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orders         Order[]
  pedidosB2b     PedidoB2b[]
  reglaEnvioLogs ReglaEnvioLog[]
  loyaltyCard    LoyaltyCard?

  @@unique([tenantId, canal, telefono])
  @@index([tenantId])
  @@map("clientes")
}

// ---------------------------------------------------------------------------
// Módulo de Lealtad (Fase 0: solo schema + andamiaje del módulo, sin
// endpoints funcionales — ver CLAUDE.md). Tarjeta de lealtad en wallet
// (Apple/Google vía WalletWallet API), sello por visita, recompensa cada 10.
// Altas desde Lealtad siempre con Cliente.canal = B2C.
// ---------------------------------------------------------------------------

enum LoyaltyCardEstado {
  EN_PROGRESO
  PREMIO_DISPONIBLE
}

// Una sola tarjeta por cliente (relación 1:1 con Cliente, clienteId
// @unique más abajo) — resuelta con upsert, no con múltiples tarjetas
// activas simultáneas por cliente.
model LoyaltyCard {
  id           String            @id @default(uuid())
  tenantId     String
  // @unique (no solo el compuesto de abajo) porque Cliente.loyaltyCard es
  // una relación 1:1 explícita — Prisma exige un unique de un solo campo en
  // el lado que declara la FK para reconocerla como tal.
  clienteId    String            @unique
  // Valor codificado en el QR personal del cliente (`barcodeValue` del
  // pase) — alta entropía, generado igual que botApiKey (ver
  // common/api-key.ts), no un UUID: es, en sí mismo, la credencial que
  // identifica la tarjeta al escanearse.
  token        String            @unique
  contador     Int               @default(0)
  estado       LoyaltyCardEstado @default(EN_PROGRESO)
  // Identificador que WalletWallet API asigna al pase (serial number del
  // .pkpass/objeto de Google Wallet) — null hasta que el pase se genera por
  // primera vez.
  serialNumber String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  tenant  Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // Restrict, no Cascade: perder el historial de sellos de un cliente
  // porque se borró su Cliente no debe pasar silenciosamente — mismo
  // criterio que Order.clienteId (ver ese comentario).
  cliente Cliente             @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  visitas LoyaltyVisit[]
  canjes  LoyaltyRedemption[]

  @@index([tenantId])
  @@map("loyalty_cards")
}

// Bitácora de sellos — un evento por visita registrada, sin campo de "quién
// registró" (el PIN es único por tenant, no por cajera, así que no hay esa
// trazabilidad en v1, ver CLAUDE.md).
model LoyaltyVisit {
  id            String   @id @default(uuid())
  tenantId      String
  loyaltyCardId String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  loyaltyCard LoyaltyCard @relation(fields: [loyaltyCardId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@map("loyalty_visits")
}

// Bitácora de canjes — un evento por premio entregado (ver LoyaltyCard.estado
// PREMIO_DISPONIBLE -> EN_PROGRESO, lógica de canje pendiente de fase
// posterior). Restrict, mismo criterio que LoyaltyVisit: no perder el
// historial de canjes de una tarjeta.
model LoyaltyRedemption {
  id            String   @id @default(uuid())
  tenantId      String
  loyaltyCardId String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  loyaltyCard LoyaltyCard @relation(fields: [loyaltyCardId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@map("loyalty_redemptions")
}

// ---------------------------------------------------------------------------
// Motor de reglas de notificación (Módulo 3, Etapa 1: solo modelo de datos +
// evaluación del Filtro — ver CLAUDE.md). Convive con el sistema de
// notificaciones por evento de arriba (NotificacionEventoConfig y compañía);
// no lo reemplaza ni se conecta con él en esta etapa. Regla junta Trigger +
// Filtro + Canal + Mensaje; ReglaEnvioLog es la bitácora de envíos — la
// primera tabla de este tipo en el proyecto (el sistema de eventos de arriba
// no registra nada en base de datos, solo logs de aplicación no
// consultables).
// ---------------------------------------------------------------------------

// EVENTO_PEDIDO: dispara en una transición de estatus de Order o PedidoB2b —
//   ver ReglaTriggerOrigenPedido y el shape de Regla.triggerConfig.
// ESTADO_CLIENTE: evaluación periódica (ej. inactividad). La condición
//   completa ("sin pedido en X días") vive en el Filtro, no aquí — este
//   trigger solo marca que la Regla debe evaluarse periódicamente (job de la
//   Etapa 2), sin duplicar la condición en dos lugares.
// FECHA_PROGRAMADA: una fecha-hora única (envío de una sola vez), no
//   recurrente — no hay soporte todavía para algo tipo "cada lunes".
// MANUAL: disparo a mano desde el panel (Etapa 3), sin job de por medio.
enum ReglaTriggerTipo {
  EVENTO_PEDIDO
  ESTADO_CLIENTE
  FECHA_PROGRAMADA
  MANUAL
}

// Alineado 1:1 a las categorías de plantilla de Meta/WhatsApp — no hay una
// tercera categoría. Gobierna el candado de frecuencia (ver ReglaEnvioLog):
// MARKETING lo tiene (máx. 1 envío por cliente por semana, global entre
// reglas), UTILITY no tiene candado.
enum ReglaMensajeCategoria {
  UTILITY
  MARKETING
}

// Hoy solo WHATSAPP tiene sentido (el envío al cliente final vía WhatsApp lo
// hace el bot de Botpress) — enum en vez de un booleano/string suelto para
// no necesitar otra migración de tipo de columna cuando se agregue un canal
// nuevo.
enum ReglaCanal {
  WHATSAPP
}

// Solo Order (EstadoPedido, 4 valores) y PedidoB2b (PedidoB2bEstado, 3
// valores, sin LISTO_ENTREGA) tienen un ciclo de vida con estatus. Un
// EVENTO_PEDIDO necesita saber de cuál de los dos viene el estatus guardado
// en Regla.triggerConfig, porque los enums no comparten dominio de forma
// segura (ej. "CONFIRMADO_SURTIENDO" existe en ambos, pero "LISTO_ENTREGA"
// solo en Order) — sin este campo, un mismo string de estatus sería
// ambiguo entre los dos modelos.
enum ReglaTriggerOrigenPedido {
  ORDER
  PEDIDO_B2B
}

// Query builder de condiciones sobre Cliente — deliberadamente cerrado, no
// un DSL de propósito general: solo los 3 campos de Cliente que hoy tiene
// sentido filtrar (ver auditoría previa, Bloque 2). Agregar un campo nuevo
// es extender este enum, no cambiar la forma del dato.
enum ReglaFiltroCampo {
  TOTAL_PEDIDOS
  ULTIMO_PEDIDO_ANTIGUEDAD_DIAS
  PRIMER_PEDIDO_ANTIGUEDAD_DIAS
}

// TOTAL_PEDIDOS admite los 3 (comparación numérica directa). Los dos campos
// de antigüedad de arriba solo admiten MAYOR_IGUAL/MENOR_IGUAL — nunca
// IGUAL, que no tiene una interpretación razonable sobre "días transcurridos
// desde ahora" — validado por ReglasFiltroService, no por Postgres.
enum ReglaFiltroOperador {
  MAYOR_IGUAL
  MENOR_IGUAL
  IGUAL
}

// Fuente de cada variable posicional de la plantilla — ver
// Regla.plantillaVariables.
enum ReglaPlantillaVariableFuente {
  CAMPO_CLIENTE
  // Solo tiene sentido para trigger = EVENTO_PEDIDO (Etapa 2c) — los demás
  // tipos de Regla no tienen un pedido de contexto que disparó el envío.
  // ReglaEnvioService lo resuelve a partir del `contexto` que le pasa el
  // caller (ReglaEventoPedidoService), no consultando Order/PedidoB2b por
  // su cuenta.
  CAMPO_PEDIDO
  // Resuelve Tenant.nombre automáticamente — a diferencia de CAMPO_PEDIDO,
  // disponible para cualquier tipo de Trigger (no hay "pedido de contexto"
  // que requerir). ReglaEnvioService ya recibe `tenant` como parámetro
  // siempre, así que no necesita datos adicionales para resolverla.
  NOMBRE_NEGOCIO
  VALOR_FIJO
}

// Regla = Trigger + Filtro + Canal + Mensaje. Esta etapa solo modela la
// definición — nada la evalúa ni la dispara todavía salvo
// ReglasFiltroService (invocado directo con un tenantId + condiciones, no
// necesariamente leyendo una fila de Regla ya guardada — ver ese servicio).
model Regla {
  id       String           @id @default(uuid())
  tenantId String
  nombre   String
  trigger  ReglaTriggerTipo

  // Shape depende de `trigger` (validado en la capa de aplicación, no por
  // Postgres — mismo principio que Promotion.config/NotificacionCanalConfig.config):
  //   EVENTO_PEDIDO    -> { origen: ReglaTriggerOrigenPedido, estatus: string
  //                         (un valor de EstadoPedido o PedidoB2bEstado según
  //                         `origen`) }
  //   ESTADO_CLIENTE   -> null — la condición vive en `filtro` (ver el
  //                        comentario de ReglaTriggerTipo arriba).
  //   FECHA_PROGRAMADA -> { fechaHora: string en ISO 8601 } — una sola vez.
  //   MANUAL           -> null.
  triggerConfig Json?

  // Lista de condiciones combinadas con Y — [] (lista vacía) significa "sin
  // filtro", matchea a todos los clientes del tenant (ver
  // ReglasFiltroService.evaluar). Cada elemento tiene la forma { campo:
  // ReglaFiltroCampo, operador: ReglaFiltroOperador, valor: number } — para
  // los dos campos de antigüedad, `valor` es siempre un número de días,
  // nunca una fecha absoluta.
  filtro Json

  canal ReglaCanal @default(WHATSAPP)

  // Plantilla de mensaje — campos embebidos, no un modelo `PlantillaMensaje`
  // aparte: esta etapa no tiene pantalla de gestión de plantillas todavía.
  // Referencian una plantilla ya registrada en Meta/WhatsApp Business
  // (nombre + idioma tal como está dada de alta ahí), no el contenido del
  // mensaje.
  plantillaNombre    String
  plantillaIdioma    String
  plantillaCategoria ReglaMensajeCategoria
  // Texto del cuerpo de la plantilla, SOLO para renderizar la vista previa
  // en el panel (Etapa 3) — nunca se manda a Botpress ni se usa en el envío
  // real (ReglaEnvioService no lo toca). Botpress tiene su propia copia
  // registrada contra Meta; esto es puramente de referencia visual para
  // quien arma la Regla, y puede quedar vacío (nadie lo pegó todavía).
  plantillaTexto     String?

  // Mapeo ordenado de las variables posicionales de la plantilla (Botpress
  // no soporta variables nombradas — confirmado contra su documentación,
  // ver ReglaEnvioService). Lista de { posicion: number, fuente:
  // ReglaPlantillaVariableFuente, valor: string }, ordenada por `posicion`
  // antes de armar el arreglo `["valor1", "valor2"]` del payload.
  //   CAMPO_CLIENTE -> `valor` es el nombre del campo de Cliente a leer —
  //                     solo `"nombre"` soportado (único campo de Cliente
  //                     con sentido como variable de mensaje).
  //   CAMPO_PEDIDO  -> `valor` es el nombre del campo del pedido a leer —
  //                     solo `"folio"` soportado (Etapa 2c). Solo tiene
  //                     sentido si `Regla.trigger = EVENTO_PEDIDO`; los
  //                     demás tipos no tienen un pedido de contexto.
  //   VALOR_FIJO    -> `valor` es el string literal a usar tal cual (ej. el
  //                     nombre del negocio).
  // Validado en la capa de aplicación (ReglaEnvioService), no por Postgres
  // — mismo principio que el resto de los `Json` de este schema.
  plantillaVariables Json @default("[]")

  activa Boolean @default(true)

  // Solo tiene sentido para trigger = FECHA_PROGRAMADA (una sola vez, no
  // recurrente — ver ReglaTriggerTipo). Null = todavía no se ha disparado;
  // ReglaBarridoService la marca con la hora de la corrida que la disparó
  // justo después de procesarla, para que corridas futuras del job (cada
  // hora) la salten aunque su fechaHora ya haya pasado. Se marca sin
  // importar si el Filtro matcheó a algún Cliente esa corrida — lo que se
  // dispara una sola vez es el trigger (la fecha ya se cumplió), no "hubo
  // al menos un envío". Siempre null para ESTADO_CLIENTE/EVENTO_PEDIDO/
  // MANUAL, que no tienen este concepto de disparo único.
  disparadaEn DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  envios ReglaEnvioLog[]

  @@index([tenantId])
  @@map("reglas")
}

// EN_CURSO: el POST a Botpress salió y fue aceptado (o el servicio de envío
// lo creó justo antes de mandarlo) — no sabemos el resultado todavía,
// Botpress lo reporta después de forma asíncrona (ver ReglaEnvioService y
// el endpoint de callback). EXITO/FALLO: resultado real, llega por ese
// callback. Un fallo síncrono del POST inicial (red caída, Botpress
// rechazó la request de plano) también se resuelve a FALLO de inmediato,
// sin esperar callback — ver ReglaEnvioService.
enum ReglaEnvioEstado {
  EN_CURSO
  EXITO
  FALLO
}

// Bitácora de envíos — primera tabla de este tipo en el proyecto (ver
// comentario de la sección arriba). `categoria` está denormalizada desde
// Regla.plantillaCategoria a propósito: el candado de frecuencia
// (ReglaCandadoService) necesita resolver "¿ya recibió Marketing en los
// últimos 7 días?" en cada evaluación de regla, sin depender de un join a
// Regla (que además es opcional/SetNull, ver abajo) — mismo principio que
// OrderItem denormalizando tenantId desde Order.
model ReglaEnvioLog {
  id        String                @id @default(uuid())
  tenantId  String
  clienteId String
  reglaId   String?
  categoria ReglaMensajeCategoria
  estado    ReglaEnvioEstado      @default(EN_CURSO)
  createdAt DateTime              @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  // SetNull, no Restrict: `categoria` ya está snapshoteada arriba, así que
  // borrar la Regla que originó este envío no pierde nada que el candado de
  // frecuencia necesite — mismo criterio que PedidoB2b.codigoDescuento (sin
  // Restrict, sin snapshot que perder).
  regla   Regla?  @relation(fields: [reglaId], references: [id], onDelete: SetNull)

  // El candado de frecuencia consulta exactamente esta combinación en cada
  // evaluación de regla Marketing — ver ReglaCandadoService.
  @@index([tenantId, clienteId, categoria, createdAt])
  @@map("regla_envio_logs")
}
