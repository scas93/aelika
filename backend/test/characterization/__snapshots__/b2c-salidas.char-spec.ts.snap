exports[`B2C · salidas recibo de Telegram ("Pedido recibido") hora específica + varias líneas (con la categoría junto al nombre) 1`] = `
"NUEVO PEDIDO #1 - Negocio cafe-test
🕓 PENDIENTE DE COBRO — se cobra al entregar/recoger
------------------------------
Cliente: Ana Prueba
Telefono: +52 55 1111 2222
Llega en: 10:45

2x Café americano (Bebidas) - $45.00 c/u = $90.00

3x Concha (Bebidas) - $30.50 c/u = $91.50

------------------------------
TOTAL: $181.50 MXN

Recibido: 30/09/2026 10:00"
`;

