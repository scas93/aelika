exports[`B2C · salidas recibo de Telegram ("Pedido recibido") DOMICILIO: el recibo no menciona entrega ni dirección (congelado tal cual) 1`] = `
"NUEVO PEDIDO #1 - Negocio cafe-test
🕓 PENDIENTE DE COBRO — se cobra al entregar/recoger
------------------------------
Cliente: Ana Prueba
Telefono: +52 55 1111 2222

1x Café americano (Bebidas) - $45.00 c/u = $45.00

------------------------------
TOTAL: $45.00 MXN

Recibido: 30/09/2026 10:00"
`;

