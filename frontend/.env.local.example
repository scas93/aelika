NEXT_PUBLIC_API_URL=http://localhost:3001

# Host que sirve el catálogo público (pide.aelika.com en producción). Las
# peticiones a este host se reescriben internamente a /tienda/{ruta} sin
# exponer /tienda/ en la URL pública. Vacío = sin reescritura (dev normal).
# En local, probar con "pide.localhost:3000".
STOREFRONT_HOST=pide.localhost:3000

# Analítica del portal de mayoreo (PostHog Cloud). Solo se usa en /mayoreo/[slug]/...
# Sin NEXT_PUBLIC_POSTHOG_KEY PostHog NO se inicializa (cero llamadas). Dejar vacío en local y staging.
NEXT_PUBLIC_POSTHOG_KEY=
# Host según la región del proyecto: https://us.i.posthog.com (US, por defecto) o https://eu.i.posthog.com (EU).
NEXT_PUBLIC_POSTHOG_HOST=
